# Copy to .env and fill in from your Supabase project
# (Dashboard → Project Settings → Data API / API Keys).
#
# EXPO_PUBLIC_ vars are inlined into the JS bundle, so only ever put the
# publishable anon key here — never the service role key. Every table is behind
# RLS, so the anon key alone grants nothing without a session.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
